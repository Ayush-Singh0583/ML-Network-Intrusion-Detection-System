{
  "raw-knowledge-base-ingestion": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/process_raw_hook.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python scripts/process_raw_hook.py",
        "timeout": 15
      }
    ]
  }
}
