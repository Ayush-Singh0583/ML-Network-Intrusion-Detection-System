  "depth": 3,
  "latent_dim": 32,
  "amp": true,
  "num_workers": 4,
  "pin_memory": true,
  "persistent_workers": true,
  "monitor": "macro_f1",
  "monitor_mode": "max",
  "seed": 42,
  "device": null,
  "target_benign_fpr": 0.05,
  "scorer": "mahalanobis_embed",
  "tags": {}
