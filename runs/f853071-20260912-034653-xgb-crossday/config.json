{
  "model": "xgb",
  "protocol": "crossday",
  "epochs": 60,
  "batch_size": 1024,
  "eval_batch_size": 8192,
  "lr": 0.001,
  "weight_decay": 0.01,
  "warmup_epochs": 3,
  "min_lr_factor": 0.01,
