{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/process_raw_hook.py || python scripts/process_raw_hook.py",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/process_raw_hook.py || python scripts/process_raw_hook.py",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/process_raw_hook.py || python scripts/process_raw_hook.py",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
